    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^2.11.0",
    "@skeletonlabs/tw-plugin": "^0.4.0",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/typography": "^0.5.15",
    "@types/eslint": "^8.56.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.24.1",
    "postcss": "^8.5.33",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.4.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-tailwind-purgecss": "^0.3.5"
  },
  "type": "module",
  "dependencies": {
    "svelte-persisted-store": "^0.12.0"
  },
  "overrides": {
    "vite": "$vite",
    "typescript": "$typescript",
    "postcss-selector-parser": "^7.2.1",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
